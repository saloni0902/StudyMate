# Must match AI_SERVICE_KEY in backend/.env
AI_SERVICE_KEY=change-me-dev-key

# Free key from https://aistudio.google.com/apikey (used from stage 4)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used automatically when the main model is overloaded
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Minimum similarity (0-1) for a question to count as covered by the notes
MIN_SCORE=0.3

# Where FAISS indexes and extracted page text are stored
INDEX_DIR=data/indexes
DOCS_DIR=data/documents

# The backend's upload folder (the AI service only reads PDFs from here)
UPLOAD_DIR=../backend/uploads
