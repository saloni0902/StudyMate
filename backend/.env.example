PORT=5050
CLIENT_ORIGIN=http://localhost:5173

# Local MongoDB or a free Atlas cluster, e.g.
# MONGO_URI=mongodb://127.0.0.1:27017/studymate
# Leave empty to use the built-in development database (data kept in backend/.data/mongo).
MONGO_URI=

# Where the Python AI service runs, and the shared key both sides use
AI_SERVICE_URL=http://localhost:8008
AI_SERVICE_KEY=change-me-dev-key

# Secret used to sign login tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Largest PDF a student can upload, in MB
MAX_UPLOAD_MB=20
