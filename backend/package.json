{
  "name": "studymate-backend",
  "version": "0.1.0",
  "private": true,
  "description": "StudyMate REST API (Node + Express + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
